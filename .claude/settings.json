{
  "language": "hebrew",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'תזכורת קבועה: עונים לעדי רק בעברית ובלשון נקבה - כל הודעה, גם משפט ביניים לפני כלי, גם עדכון אחרי פעולה בדפדפן, וגם ה-recap, ה-ask והכפתורים בתיבת הסיכום. לפני ששולחים: לבדוק שהשורה הראשונה בעברית.'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/office/hooks/log-event.js\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/office/hooks/log-event.js\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/office/hooks/log-event.js\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/office/hooks/log-event.js\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
