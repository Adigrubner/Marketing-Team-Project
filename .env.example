# ============================================
# הכספת שלכם - מפתחות וסודות
# מעתיקים את הקובץ הזה לקובץ בשם .env
# וממלאים ערכים לפי השיעורים.
# את .env לא משתפים עם אף אחד, אף פעם!
# ============================================

# --- חלק 4: הקריאייטיבית (יצירת תמונות) ---
OPENAI_API_KEY=
# אופציונלי: איזה מודל תמונות (ברירת מחדל gpt-image-2)
OPENAI_IMAGE_MODEL=

# --- חלק 5: חיבור Meta ---
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
# חשבון האינסטגרם שבשמו רצות המודעות (npm run doctor מוצא את המספר אחרי שהדף מחובר)
META_INSTAGRAM_USER_ID=
# אופציונלי: מספר הוואטסאפ העסקי (רק אם לדף מחוברים כמה מספרים). פורמט בינלאומי, למשל 972501234567
META_WHATSAPP_NUMBER=
# אופציונלי: גרסת ה-API (ברירת מחדל v26.0)
META_GRAPH_VERSION=
